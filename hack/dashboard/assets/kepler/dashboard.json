      },
      "description": "Total Power Consumption of the Cluster. Using Psys power to depict the total power. Will use Package if Psys is not available",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              }
            ]
          },
          "unit": "watt"
